# Copy to .env and adjust. Every value here also has a sane default, so an
# empty .env works fine against devnet with your default Solana CLI wallet.

# RPC for the scripts, the crank, and the browser-facing proxy. A private
# Helius/QuickNode URL belongs HERE - not in the repo-root VITE_SOLANA_RPC_URL,
# which is shipped to every visitor.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Upstream websocket for the proxy. Derived from SOLANA_RPC_URL (https -> wss)
# unless your provider serves subscriptions from a different host.
# SOLANA_WS_URL=

# --- rpc-proxy (scripts/rpc-proxy.ts) ---
# Browser origins allowed to use the proxy. Empty allows any, which is fine
# locally but means anyone can spend your credits in production.
PROXY_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# PORT=8080
# Per-IP token bucket: burst covers one page boot, refill is the steady rate.
# PROXY_RATE_BURST=60
# PROXY_RATE_REFILL=15
# PROXY_MAX_WS_PER_IP=4

# Default signer for every script. Override per-command with --wallet <path>.
ANCHOR_WALLET=~/.config/solana/id.json

# Only needed if you deploy to a different program id than the one baked into
# the IDL (e.g. after `solana-keygen new -o target/deploy/soldust-keypair.json`).
# SOLDUST_PROGRAM_ID=CoriumcqGZW3cdnAiyWz6jHHveMUmdrw9RC1KXfMsF8S

# History + chat. Service role is server-only - never VITE_*. The crank
# indexes events with it; the proxy uses the same key to write `corium_chat`
# after verifying the wallet signed the message. Without it, /health reports
# `"chat":false` and the table stays read-only.
# One project for both clusters: rows are split on SOLANA_CLUSTER
# (devnet | mainnet). Inferred from SOLANA_RPC_URL when unset.
# SOLANA_CLUSTER=devnet
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
